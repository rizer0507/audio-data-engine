{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intent_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "confidence",
    "insufficient_evidence",
    "rationale"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "agree",
        "disagree",
        "ask_clarify",
        "request_action",
        "provide_info",
        "other",
        "unknown"
      ],
      "description": "仅依据指定家族识别文本判断的业务意图"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "insufficient_evidence": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string"
    }
  }
}
