# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env

# --- 测试 / 工具 ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- IDE ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- 运行时可删产物（不进 Git）---
# 算子结果缓存：可随意删除，下次重跑会重建
data/cache/*
!data/cache/.gitkeep

# 转码/重采样等派生音频
data/derived/*
!data/derived/.gitkeep

# 若使用 --copy 拷入的原始音频副本
data/raw/*
!data/raw/.gitkeep

# 导出训练集等交付物（按需本地保留）
data/exports/*
!data/exports/.gitkeep

# 每次 pipeline/run 的运行目录
runs/*
!runs/.gitkeep

# 流水线生成的样本级 manifest（逻辑产物，体积大）
datasets/manifests/*
!datasets/manifests/.gitkeep
!datasets/manifests/README.md

# 比对/评测产物（含超大 parquet，勿提交）
qwen_vs_sensevoice/
*.parquet

# 本地临时 / 杂项
*.bak
*.bak_*
