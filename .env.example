# 豆包语音控制台 → 服务接口认证信息
# 旧版：DOUBAO_ASR_APP_KEY（APP ID）+ DOUBAO_ASR_ACCESS_KEY（Access Token）
# 新版：DOUBAO_ASR_API_KEY（单 Key，与上面二选一）
# Secret Key 不需要用于录音文件识别大模型 v3 API
DOUBAO_ASR_APP_KEY=
DOUBAO_ASR_ACCESS_KEY=
DOUBAO_ASR_API_KEY=

# 可选，默认 volc.seedasr.auc（录音文件识别 2.0）
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.auc
